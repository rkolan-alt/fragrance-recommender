# Reference only: store real values in Secret Manager / service environment.
ENVIRONMENT=production
COOKIE_SECURE=true
AUTH_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Runtime uses pooled connection; store both URLs privately in Secret Manager.
DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@YOUR_NEON_POOLER_HOST/neondb?sslmode=require
# Migration job only:
DATABASE_URL_UNPOOLED=postgresql://USER:ENCODED_PASSWORD@YOUR_NEON_DIRECT_HOST/neondb?sslmode=require
FRONTEND_ORIGIN=https://YOUR_WEBSITE_HOST
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_ROTATED_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URL=https://YOUR_WEBSITE_HOST/api/account/auth/google/callback
# Google-only launch: no paid domain or email delivery required.
EMAIL_PASSWORD_ENABLED=false
# To enable email/password later, configure Resend + verified sender first.
# EMAIL_BACKEND=resend
# RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
# EMAIL_FROM=Fragrance Recommender <hello@YOUR_VERIFIED_DOMAIN>
DATA_DIR=/data
PRICING_AUTO_REFRESH=false
PRICING_DAILY_REQUEST_LIMIT=10
# Next.js server environment, separate from backend secrets:
FRAGRANCE_API_URL=https://YOUR_BACKEND_HOST
FRAGRANCE_PUBLIC_ORIGIN=https://YOUR_WEBSITE_HOST
# Keep a single backend worker/instance until a shared limiter is configured.
RATE_LIMIT_STORAGE_URI=memory://
