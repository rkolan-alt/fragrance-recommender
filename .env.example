ENVIRONMENT=development
# Backend
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SERPAPI_KEY=
# Opt in after configuring the key; scheduled/manual refresh also obeys the daily cap.
PRICING_AUTO_REFRESH=false
PRICING_DAILY_REQUEST_LIMIT=10
PRICING_LAZY_PER_REQUEST=2
PRICING_CACHE_DAYS=7
# Set a stable random value (at least 32 characters) before deployment.
AUTH_SECRET=change-me
# false for HTTP localhost; true for HTTPS deployment
COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=604800
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8001/auth/google/callback
# Development emails are saved locally; switch to resend for delivery.
EMAIL_BACKEND=outbox
RESEND_API_KEY=
EMAIL_FROM=Fragrance Recommender <onboarding@resend.dev>
# Per-process development limiter; configure a shared supported backend when scaling.
RATE_LIMIT_STORAGE_URI=memory://
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (optional: set in frontend/.env.local if the backend address changes)
# Only the Next.js server reads this; browser calls stay on /api.
FRAGRANCE_API_URL=http://127.0.0.1:8001

# Set on the deployed Next.js server to validate browser origins behind HTTPS proxies.
# FRAGRANCE_PUBLIC_ORIGIN=https://YOUR_WEBSITE_HOST
