# Backend
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SERPAPI_KEY=
# Set a stable random value (at least 32 characters) before deployment.
AUTH_SECRET=change-me
# false for HTTP localhost; true for HTTPS deployment
COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=604800
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8001/auth/google/callback
# Development emails are saved locally; switch to resend for delivery.
EMAIL_BACKEND=outbox
RESEND_API_KEY=
EMAIL_FROM=Fragrance Recommender <onboarding@resend.dev>
# Per-process development limiter; configure a shared supported backend when scaling.
RATE_LIMIT_STORAGE_URI=memory://
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
